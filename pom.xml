<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--父工程-->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <!--分组信息-->
    <groupId>com.quanwei</groupId>
    <artifactId>gogo-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gogo-agent</name>
    <description>gogo-agent</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sa-token.version>1.39.0</sa-token.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <agentscope.version>2.0.2</agentscope.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--AgentScope Java：多智能体框架，2.0.x 对齐 Spring Boot 4 / Spring Framework 7-->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-bom</artifactId>
                <version>${agentscope.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--spring启动类-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--必须用 boot3 starter：boot2 starter 依赖 sa-token-servlet -> javax.servlet，
            Boot 4 是 jakarta 命名空间，用 boot2 starter 会在启动时找不到类-->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!--mybatis-plus-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--MP 3.5.9 起 jsqlparser 被拆成独立模块-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--MySQL 驱动-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--只取 BCrypt 密码加密-->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--Boot 4 自带的是 Jackson 3（tools.jackson.*），而 sa-token-redis-jackson 用的是 Jackson 2，
            不补这个依赖启动时会 ClassNotFoundException: com.fasterxml.jackson.databind.JsonSerializer。
            两套 Jackson 包名完全不同，可以共存-->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.21.6</version>
        </dependency>

        <!--sa-token 序列化 LocalDateTime 要用 Jackson 2 的 JSR-310 模块-->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.21.6</version>
        </dependency>

        <!--AgentScope 智能体框架。选 openai starter 而不是 dashscope，
            是因为通义/DeepSeek/豆包/Kimi 都提供 OpenAI 兼容接口，换模型只改 base-url-->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-openai-spring-boot-starter</artifactId>
        </dependency>

        <!--DashScope 原生协议扩展。用它而不是 openai 兼容模式，是因为 enableThinking /
            enableSearch 这些开关只有原生 builder 上有，兼容模式表达不了。
            版本由 agentscope-bom 统一管，不用写 version-->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
        </dependency>

        <!--lombok，版本由 spring-boot-starter-parent 管理（1.18.46）-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
