<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quanwei.gogo.agent.mapper.ChatConversationMapper">

    <resultMap id="BaseResultMap" type="com.quanwei.gogo.agent.entity.ChatConversation">
        <id     column="conversation_id" property="conversationId"/>
        <result column="user_id"         property="userId"/>
        <result column="title"           property="title"/>
        <result column="created_time"    property="createdTime"/>
        <result column="updated_time"    property="updatedTime"/>
        <result column="deleted"         property="deleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        conversation_id, user_id, title, created_time, updated_time, deleted
    </sql>

</mapper>
